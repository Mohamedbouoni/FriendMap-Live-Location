# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://friendmap:friendmap_dev@localhost:5432/friendmap

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-random-256-bit-key
JWT_EXPIRY=24h

# ─── Server ─────────────────────────────────────────────
API_PORT=3000
CLIENT_URL=http://localhost:5173

# ─── Location Validation ───────────────────────────────
MAX_SPEED_KMH=500
TIMESTAMP_MAX_AGE_SEC=60
TIMESTAMP_MAX_FUTURE_SEC=10
LOCATION_TTL_SEC=86400

# ─── Rate Limiting ─────────────────────────────────────
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SEC=60
WS_LOCATION_RATE_PER_SEC=1
WS_LOCATION_BURST=3
